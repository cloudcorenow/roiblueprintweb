# Example environment variables for local development
# Copy this file to .dev.vars and fill in your values

# Cloudflare D1 Database
# The database binding 'DB' is automatically configured via wrangler.toml
# No environment variables needed for D1

# Resend API Key for email notifications
RESEND_API_KEY=your_resend_api_key_here

# Cloudflare Turnstile Secret Key for CAPTCHA verification
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
